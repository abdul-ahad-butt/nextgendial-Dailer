{
  "name": "nextgendial",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "pnpm --filter @nextgendial/api dev",
    "dev:web": "pnpm --filter @nextgendial/web dev",
    "dev:super": "pnpm --filter @nextgendial/superadmin dev",
    "build:api": "pnpm --filter @nextgendial/api build",
    "build:web": "pnpm --filter @nextgendial/web build",
    "build:super": "pnpm --filter @nextgendial/superadmin build",
    "typecheck": "pnpm --filter @nextgendial/api typecheck && pnpm --filter @nextgendial/web typecheck && pnpm --filter @nextgendial/superadmin typecheck",
    "deploy:api": "pnpm --filter @nextgendial/api deploy"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.5.3"
  }
}
