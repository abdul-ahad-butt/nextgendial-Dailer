{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@nextgendial/shared-types": ["../../packages/shared-types/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/shared-types/index.ts"],
  "exclude": ["node_modules"]
}
